# CINE BOSS - Variaveis de Ambiente
# Configure estas variaveis no Vercel Dashboard > Settings > Environment Variables
# NUNCA commite valores reais neste arquivo

# TMDB API (obter em https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Supabase (obter em https://supabase.com/dashboard)
SUPABASE_URL=
SUPABASE_KEY=

# JWT Secret (gerar string aleatoria segura)
JWT_SECRET=

# Mercado Pago (obter em https://www.mercadopago.com.br/developers/panel)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# Email opcional (obter em https://resend.com)
RESEND_API_KEY=

# URL do site
SITE_URL=https://cineboss.vercel.app
